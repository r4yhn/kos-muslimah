# ============================================================
# Salin file ini menjadi `.env` lalu isi nilai sesungguhnya.
# JANGAN commit file `.env` ke git (sudah di-ignore).
# ============================================================

# --- Drizzle ORM / Drizzle Kit (koneksi PostgreSQL Supabase) ---
# Pakai Session pooler (port 5432, mode direct) untuk migrasi / CLI.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- @supabase/supabase-js (klien runtime) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# --- Auth.js (NextAuth v5) ---
# Generate: npx auth secret  (atau node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Midtrans (Pembayaran Online Otomatis — Snap) ---
# Daftar di https://dashboard.sandbox.midtrans.com (sandbox) atau
# https://dashboard.midtrans.com (produksi) → Settings → Access Keys.
# Server key sandbox diawali "SB-Mid-server-"; client key "SB-Mid-client-".
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=true   # kosongkan / false = mode sandbox

# --- Seed Admin (npm run db:seed) ---
# SEED_ADMIN_NAME=Admin Kos Pondok Muslimah
# SEED_ADMIN_EMAIL=admin@kosmuslimah.com
# SEED_ADMIN_PASSWORD=GantiDenganPasswordKuat123
